    ["Status", "Status"],
    ["AI Companion", "Companion"],
    ["Missions", "Missions"],
    ["Diagnostic Hub", "Diagnos"],
    ["Server logs", "logs"],
    ["MCP Tools", "Tool"],
    ["Settings", "Settings"],
    ["Help", "Help"]
  ]
}
