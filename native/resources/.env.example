# Yahboom MCP — Required Configuration
# Copy this file to .env and fill in your values.
# WARNING: Do NOT commit the real .env file — it contains secrets.

# Robot connection
YAHBOOM_IP=
YAHBOOM_BRIDGE_PORT=9090
YAHBOOM_ESP32_PORT=2323

# SSH access to robot (optional, for remote diagnostics)
YAHBOOM_SSH_USER=
YAHBOOM_SSH_PASSWORD=
YAHBOOM_SSH_KEYFILE=

# LLM / Ollama (optional)
OLLAMA_BASE_URL=
LMSTUDIO_BASE_URL=

# Mock mode for testing without hardware
YAHBOOM_USE_MOCK_BRIDGE=

# Robot voice module serial device (optional; auto-discovered via udev otherwise)
YAHBOOM_VOICE_DEVICE=

# ROS 2 driver-stack Docker container on the Pi
YAHBOOM_ROS2_CONTAINER=yahboom_ros2_final

# ROS topic for agent mission JSON publish
YAHBOOM_MISSION_TOPIC=/boomy/mission

# Gemini key for agent mission planning (provider "gemini"; falls back to Ollama when unset)
YAHBOOM_GEMINI_API_KEY=
YAHBOOM_GEMINI_MISSION_MODEL=gemini-2.0-flash

# Dreame D20 Pro floorplan map (Boomy's house layer)
# Points at the standalone dreame-mcp server; also used by the Lidar Map
# page and ros2/boomy_dreame_map_bridge (Nav2 OccupancyGrid).
DREAME_MAP_URL=http://127.0.0.1:10894/api/v1/map
